#!/usr/bin/env bash
# factory-box - the preview lifecycle, run ON the VPS (by the CI runner or by
# hand as root/factory). Touches only factory-owned things: compose projects
# <prefix>-pr-<N>, databases in the factory-pg container, /srv/factory.
#
#   factory-box snapshot-all                       every project with a SOURCE_DB_CONTAINER
#   factory-box snapshot <project>                  staging -> <prefix>_snapshot (disarmed) + media
#   factory-box up   <project> <N> <checkout> <branch>   build + start/refresh PR N's preview
#   factory-box down <project> <N>                  delete PR N's preview entirely
#   factory-box reset <project> <N>                 re-copy PR N's DB + media from the snapshot
#   factory-box e2e  <project> <N> <checkout> <sha>   run e2e with video, publish the gallery
#   factory-box sync                               (root) networks, gateway routes, host vhosts from projects/*
#   factory-box runner-add <owner/repo> <token> [i] (root) one more self-hosted runner, label factory
#   factory-box self-update                        (root) pull the factory repo, sync if it changed
#   factory-box status                            (root) write /srv/factory/state/status.json for the dashboard
#   factory-box agent-say <task-id>  < message      post a [factory] report into a factory-agents task
#   factory-box ls                                  running previews
set -euo pipefail
FACTORY_DIR="$(cd "$(dirname "$(readlink -f "$0")")/.." && pwd)"
cmd="${1:-}"; shift || true
cd /srv/factory  # compose stats its cwd, and root's home is not readable to us

die() { echo "factory-box: $*" >&2; exit 1; }
log() { echo "[$(date -u +%H:%M:%S)] $*" >&2; }

load_project() {
  project="$1"; PROJECT_DIR="$FACTORY_DIR/projects/$project"
  [ -f "$PROJECT_DIR/project.sh" ] || die "unknown project $project"
  # shellcheck source=/dev/null
  . "$PROJECT_DIR/project.sh"
}

pg()   { docker exec -i factory-pg-1 psql -v ON_ERROR_STOP=1 -U factory -d "${2:-postgres}" -qAtc "$1"; }
pgf()  { docker exec -i factory-pg-1 psql -v ON_ERROR_STOP=1 -U factory -d "$1" -q; }
pgpw() { sed -n 's/^POSTGRES_PASSWORD=//p' /opt/factory/.env; }
media_root() { echo "/srv/factory/media/$PREFIX"; }

# feature slug from a branch: drop feat/ fix/ ..., lowercase, a-z0-9-, 40 chars
slug() {
  local s="${1#*/}"; s="$(printf '%s' "$s" | tr 'A-Z' 'a-z' | sed -E 's/[^a-z0-9]+/-/g; s/^-+|-+$//g')"
  s="${s:0:40}"; s="${s%-}"; printf '%s' "${s:-pr}"
}

snapshot() {
  load_project "$1"
  local next="${PREFIX}_snapshot_next" snap="${PREFIX}_snapshot" old="${PREFIX}_snapshot_old"
  log "dump $SOURCE_DB_CONTAINER/$SOURCE_DB_NAME"
  local user; user="$(docker exec "$SOURCE_DB_CONTAINER" printenv POSTGRES_USER)"
  pg "DROP DATABASE IF EXISTS $next" ; pg "CREATE DATABASE $next"
  docker exec "$SOURCE_DB_CONTAINER" pg_dump -U "$user" -d "$SOURCE_DB_NAME" -Fc --no-owner --no-acl |
    docker exec -i factory-pg-1 pg_restore -U factory -d "$next" --no-owner --no-acl --exit-on-error
  log "disarm"
  pgf "$next" < "$PROJECT_DIR/disarm.sql"
  # nobody may connect to the template, or CREATE DATABASE ... TEMPLATE refuses
  pg "DROP DATABASE IF EXISTS $old"
  if [ "$(pg "SELECT 1 FROM pg_database WHERE datname='$snap'")" = 1 ]; then
    pg "ALTER DATABASE $snap RENAME TO $old"
  fi
  pg "ALTER DATABASE $next RENAME TO $snap"
  pg "DROP DATABASE IF EXISTS $old"
  pg "COMMENT ON DATABASE $snap IS 'snapshot of $SOURCE_DB_CONTAINER taken $(date -u +%FT%TZ)'"
  log "media from volume $SOURCE_MEDIA_VOLUME"
  mkdir -p "$(media_root)/snapshot"
  docker run --rm -v "$SOURCE_MEDIA_VOLUME:/src:ro" -v "$(media_root):/dst" alpine:3.20 \
    sh -c 'apk add -q rsync >/dev/null && rsync -a --delete /src/ /dst/snapshot/'
  log "snapshot ready: $snap"
}

copy_data() {  # N
  local db="${PREFIX}_pr_$1"
  [ "$(pg "SELECT 1 FROM pg_database WHERE datname='${PREFIX}_snapshot'")" = 1 ] ||
    die "no snapshot yet: run factory-box snapshot $project"
  pg "DROP DATABASE IF EXISTS $db WITH (FORCE)"
  pg "CREATE DATABASE $db TEMPLATE ${PREFIX}_snapshot"
  # hardlinks: instant and free; the app only ever writes new files
  docker run --rm -v "$(media_root):/m" alpine:3.20 sh -c "rm -rf /m/pr-$1 && cp -al /m/snapshot /m/pr-$1"
}

up() {
  load_project "$1"; local n="$2" checkout="$3" branch="${4:-pr}"
  [ -d "$checkout" ] || die "no checkout at $checkout"
  local host; host="$(slug "$branch")-pr$n.$DOMAIN"
  log "build images for PR $n"
  build_images "$checkout" "pr-$n"
  # a project with no database (no SOURCE_DB_CONTAINER) gets none
  if [ -n "${SOURCE_DB_CONTAINER:-}" ] &&
     [ "$(pg "SELECT 1 FROM pg_database WHERE datname='${PREFIX}_pr_$n'")" != 1 ]; then
    log "first push: copy data"; copy_data "$n"
  fi
  mkdir -p "$(media_root)/pr-$n" 2>/dev/null || true
  local secret_file="/srv/factory/state/$PREFIX-pr-$n.secret"
  mkdir -p /srv/factory/state
  [ -s "$secret_file" ] || (umask 077; openssl rand -hex 32 > "$secret_file")
  log "start cc-pr-$n at https://$host"
  PR="$n" IMAGE_API="$IMAGE_API" IMAGE_WEB="$IMAGE_WEB" PREVIEW_HOST="$host" \
  DB_URL="postgresql+asyncpg://factory:$(pgpw)@factory-pg-1:5432/${PREFIX}_pr_$n" \
  MEDIA_DIR="$(media_root)/pr-$n" PROJECT_DIR="$PROJECT_DIR" SESSION_SECRET="$(cat "$secret_file")" \
    docker compose -f "$PROJECT_DIR/preview.compose.yaml" up -d --wait --remove-orphans >&2
  printf '%s\n' "$host" > "/srv/factory/state/$PREFIX-pr-$n.host"
  local code
  code="$(docker exec factory-gateway-1 wget -qS -O /dev/null --header "Host: $host" "http://127.0.0.1$HEALTH_PATH" 2>&1 | awk '/HTTP\//{print $2}' | tail -1)"
  [ "$code" = 200 ] || die "preview is up but $HEALTH_PATH answered ${code:-nothing} through the gateway"
  log "ready"
  echo "https://$host$LOGIN_PATH"
}

down() {
  load_project "$1"; local n="$2"
  docker compose -p "$PREFIX-pr-$n" down --remove-orphans -t 10 >&2 2>/dev/null || true
  pg "DROP DATABASE IF EXISTS ${PREFIX}_pr_$n WITH (FORCE)"
  pg "DROP ROLE IF EXISTS ${PREFIX}_pr_$n"   # the preview's own login (Coolify previews)
  docker run --rm -v "$(media_root):/m" alpine:3.20 rm -rf "/m/pr-$n"
  rm -rf "/srv/factory/artifacts/$PREFIX/pr-$n" "/srv/factory/state/$PREFIX-pr-$n".*
  docker image rm "factory/$PREFIX-api:pr-$n" "factory/$PREFIX-web:pr-$n" >/dev/null 2>&1 || true
  log "PR $n deleted"
}

e2e() {
  load_project "$1"; local n="$2" checkout="$3" sha="${4:-run}"
  local host; host="$(cat "/srv/factory/state/$PREFIX-pr-$n.host" 2>/dev/null)" || die "PR $n has no preview"
  export PATH="/opt/factory/node/bin:$PATH" PLAYWRIGHT_BROWSERS_PATH=/opt/factory/ms-playwright \
         npm_config_cache=/opt/factory/npm-cache CI=1
  local code=0
  run_e2e "$checkout" "$n" "https://$host$APP_PATH" >&2 || code=$?
  local root="/srv/factory/artifacts/$PREFIX/pr-$n" out="$checkout/$E2E_OUT_DIR"
  local run="$root/runs/$(date -u +%Y%m%dT%H%M%SZ)-${sha:0:7}"
  mkdir -p "$run"
  [ -f "$out/report.json" ] || { echo "no report (exit $code)"; return "$code"; }
  cp -a "$out/." "$run/"
  local summary
  summary="$(node "$FACTORY_DIR/tools/gallery.mjs" "$run" "PR $n · ${sha:0:7} · e2e")"
  # the newest run is what /_factory/ shows; keep the last 5
  ln -sfn "runs/$(basename "$run")" "$root/latest"
  printf '<meta http-equiv="refresh" content="0; url=latest/">\n' > "$root/index.html"
  ls -1d "$root"/runs/* | sort | head -n -5 | xargs -r rm -rf
  echo "$summary"
  return "$code"
}

sync() {
  [ "$(id -u)" = 0 ] || die "sync needs root (it writes host nginx)"
  local map=/opt/factory/gateway/projects.map.inc vhost=/etc/nginx/sites-available/factory-previews.conf
  local newmap newvhost; newmap="$(mktemp)"; newvhost="$(mktemp)"
  printf '# generated by factory-box sync from %s/projects - do not edit\n' "$FACTORY_DIR" | tee "$newvhost" > "$newmap"
  local conf
  for conf in "$FACTORY_DIR"/projects/*/project.sh; do
    (
      # shellcheck source=/dev/null
      . "$conf"
      [ -n "${DOMAIN:-}" ] && [ -n "${PREFIX:-}" ] || { echo "skip $conf: no DOMAIN/PREFIX" >&2; exit 0; }
      cert="${CERT:-/etc/ssl/cloudflare/$DOMAIN.pem}"; key="${CERT_KEY:-${cert%.pem}.key}"
      [ -f "$cert" ] && [ -f "$key" ] || { echo "skip $DOMAIN: no origin cert at $cert" >&2; exit 0; }
      re="${DOMAIN//./\\.}"
      printf '    ~\\.%s$  %s;\n' "$re" "$PREFIX" >> "$newmap"
      cat >> "$newvhost" <<VHOST

# $DOMAIN -> project $PREFIX
server {
    listen 443 ssl http2;
    listen [::]:443 ssl http2;
    server_name ~^[a-z0-9-]+-pr\d+\.$re\$;
    ssl_certificate     $cert;
    ssl_certificate_key $key;
    if (\$from_cloudflare = 0) { return 444; }
    server_tokens off;
    add_header X-Robots-Tag "noindex, nofollow" always;
    add_header X-Content-Type-Options nosniff always;
    include /opt/factory/src/box/nginx-factory-auth.inc;
    client_max_body_size 64m;
    location / {
        proxy_pass http://127.0.0.1:19100;
        proxy_set_header Host \$host;
        proxy_set_header X-Real-IP \$remote_addr;
        proxy_set_header X-Forwarded-For \$proxy_add_x_forwarded_for;
        proxy_read_timeout 300s;
        proxy_buffering off;
    }
}
VHOST
      # sandboxes run by Coolify (pr<N>.<domain>): to its Traefik on loopback
      if [ "${SANDBOXES:-}" = coolify ]; then
        cat >> "$newvhost" <<VHOST

# $DOMAIN -> Coolify sandboxes (Traefik, loopback only)
server {
    listen 443 ssl http2;
    listen [::]:443 ssl http2;
    server_name ~^pr\d+\.$re\$;
    ssl_certificate     $cert;
    ssl_certificate_key $key;
    if (\$from_cloudflare = 0) { return 444; }
    server_tokens off;
    add_header X-Robots-Tag "noindex, nofollow" always;
    add_header X-Content-Type-Options nosniff always;
    include /opt/factory/src/box/nginx-factory-auth.inc;
    client_max_body_size 64m;
    # e2e videos and reports live with the factory, not in the sandbox
    location ^~ /_factory/ {
        proxy_pass http://127.0.0.1:19100;
        proxy_set_header Host \$host;
    }
    location = /_factory/login {
        proxy_pass http://127.0.0.1:18080;
        proxy_set_header Host \$host;
    }
    location / {
        proxy_pass http://127.0.0.1:18080;
        proxy_set_header Host \$host;
        proxy_set_header X-Real-IP \$remote_addr;
        proxy_set_header X-Forwarded-For \$proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto https;
        proxy_read_timeout 300s;
        proxy_buffering off;
    }
}
VHOST
      fi
      net="factory-$PREFIX"
      docker network inspect "$net" >/dev/null 2>&1 || docker network create "$net" >/dev/null
      for c in factory-gateway-1 factory-pg-1; do
        docker network connect "$net" "$c" 2>/dev/null || true
      done
      echo "project $PREFIX: *.$DOMAIN, network $net" >&2
    )
  done
  install -m 644 "$newmap" "$map"
  local old=""; [ -f "$vhost" ] && old="$(mktemp)" && cp "$vhost" "$old"
  install -m 644 "$newvhost" "$vhost"
  ln -sf "$vhost" /etc/nginx/sites-enabled/factory-previews.conf
  if ! nginx -t 2>/dev/null; then
    if [ -n "$old" ]; then install -m 644 "$old" "$vhost"; else rm -f /etc/nginx/sites-enabled/factory-previews.conf; fi
    rm -f "$newmap" "$newvhost" "$old"
    die "nginx -t failed with the new preview vhosts: old ones restored, nothing reloaded"
  fi
  systemctl reload nginx
  docker exec factory-gateway-1 nginx -s reload >/dev/null 2>&1
  rm -f "$newmap" "$newvhost" "$old"
  log "synced"
}

runner_add() {  # owner/repo token [index]: several per repo run jobs in parallel
  [ "$(id -u)" = 0 ] || die "runner-add needs root"
  local repo="$1" token="$2" name; name="$(echo "$1" | tr '/' '-')${3:+-$3}"
  local dir="/opt/factory/runners/$name" ver=2.338.0
  local tgz="/opt/factory/runner-dist/actions-runner-linux-x64-$ver.tar.gz"
  if [ ! -f "$tgz" ]; then
    install -d /opt/factory/runner-dist
    curl -sfL -o "$tgz" "https://github.com/actions/runner/releases/download/v$ver/actions-runner-linux-x64-$ver.tar.gz"
  fi
  if [ ! -x "$dir/config.sh" ] || [ ! -f "$dir/.runner" ]; then
    rm -rf "$dir"; install -d -o factory -g factory "$dir" "/srv/factory/runner-work/$name"
    tar -xzf "$tgz" -C "$dir"; chown -R factory:factory "$dir"
  fi
  (cd "$dir" && sudo -u factory ./config.sh --unattended --url "https://github.com/$repo" --token "$token" \
     --name "factory-vps-$name" --labels factory --work "/srv/factory/runner-work/$name" --replace >&2 &&
   ./svc.sh install factory >/dev/null && ./svc.sh start >/dev/null)
  log "runner factory-vps-$name online for $repo"
}

self_update() {
  [ "$(id -u)" = 0 ] || die "self-update needs root"
  local before after
  before="$(git -C "$FACTORY_DIR" rev-parse HEAD)"
  GIT_SSH_COMMAND="ssh -i /opt/factory/deploy_key -o IdentitiesOnly=yes" git -C "$FACTORY_DIR" fetch -q
  after="$(git -C "$FACTORY_DIR" rev-parse '@{u}')"
  [ "$before" = "$after" ] && return 0
  # a shell file that does not parse would run here within minutes: stay on the
  # old commit until main is fixed (logged once per refused commit)
  local f bad=""
  for f in $(git -C "$FACTORY_DIR" ls-tree -r --name-only "$after" | grep -E '^bin/[^/]+$|\.sh$'); do
    git -C "$FACTORY_DIR" show "$after:$f" | bash -n 2>/dev/null || bad="$bad $f"
  done
  # the services that run from this checkout (agents, bot, dashboard) are
  # JavaScript + JSON: an agent's merge must not take them down either
  local js; js="$(mktemp -d)"
  for f in $(git -C "$FACTORY_DIR" ls-tree -r --name-only "$after" | grep -E '\.mjs$|^agents/projects\.json$'); do
    case "$f" in
      *.json) git -C "$FACTORY_DIR" show "$after:$f" | /opt/factory/node/bin/node -e 'JSON.parse(require("fs").readFileSync(0, "utf8"))' 2>/dev/null || bad="$bad $f" ;;
      *) git -C "$FACTORY_DIR" show "$after:$f" > "$js/check.mjs" && /opt/factory/node/bin/node --check "$js/check.mjs" 2>/dev/null || bad="$bad $f" ;;
    esac
  done
  rm -rf "$js"
  if [ -n "$bad" ]; then
    [ "$(cat /srv/factory/state/refused 2>/dev/null)" = "$after" ] ||
      { log "factory $after REFUSED, syntax error in:$bad"; echo "$after" > /srv/factory/state/refused; }
    return 0
  fi
  git -C "$FACTORY_DIR" merge -q --ff-only "$after"
  log "factory $before -> $after"
  # factory apps in Coolify (box/coolify/factory-apps): redeploy the ones whose folder changed
  local changed; changed="$(git -C "$FACTORY_DIR" diff --name-only "$before" "$after")"
  local dir uuid
  while read -r dir uuid; do
    case "$dir" in ''|'#'*) continue ;; esac
    if printf '%s\n' "$changed" | grep -q "^$dir/"; then
      curl -fsS -o /dev/null -X POST -H "Authorization: Bearer $(cat /opt/factory/coolify-token)" \
        "http://127.0.0.1:8000/api/v1/deploy?uuid=$uuid" && log "coolify: redeploying $dir" || log "coolify: redeploy of $dir FAILED"
    fi
  done < "$FACTORY_DIR/box/coolify/factory-apps"
  install -m 644 "$FACTORY_DIR/box/gateway/nginx.conf" /opt/factory/gateway/default.conf
  install -m 644 "$FACTORY_DIR/box/factory.cron" /etc/cron.d/factory
  # host services that run straight from this checkout
  if printf '%s\n' "$changed" | grep -q "^agents/"; then systemctl restart factory-agents && log "factory-agents restarted"; fi
  # the functions in memory are the old ones: sync with the script just pulled
  exec "$FACTORY_DIR/bin/factory-box" sync
}

status() {
  # facts about the bootstrap layer, read by the dashboard (which has no docker access)
  local out=/srv/factory/state/status.json tmp; tmp="$(mktemp)"
  {
    printf '{"at":"%s",' "$(date -u +%FT%TZ)"
    printf '"factory_commit":"%s",' "$(git -C "$FACTORY_DIR" log -1 --format='%h %s' | sed 's/["\\]/ /g')"
    printf '"disk_used_pct":%s,' "$(df --output=pcent / | tail -1 | tr -dc 0-9)"
    printf '"mem_available_gb":%s,' "$(free -g | awk '/^Mem/{print $7}')"
    printf '"runners":['
    local first=1 u
    for u in $(systemctl list-units --type=service --all --no-legend 'actions.runner.*' | awk '{print $1}'); do
      [ $first = 1 ] || printf ','; first=0
      printf '{"name":"%s","active":"%s"}' "${u#actions.runner.}" "$(systemctl is-active "$u")"
    done
    printf '],'
    printf '"services":{'
    printf '"firewall":"%s",' "$(systemctl is-active factory-sandbox-firewall 2>/dev/null)"
    printf '"agent_shim":"%s",' "$(systemctl is-active open-inspect-sandbox-shim 2>/dev/null)"
    printf '"gateway":"%s",' "$(docker inspect -f '{{.State.Status}}' factory-gateway-1 2>/dev/null || echo missing)"
    printf '"preview_postgres":"%s",' "$(docker inspect -f '{{.State.Status}}' factory-pg-1 2>/dev/null || echo missing)"
    printf '"coolify":"%s",' "$(docker inspect -f '{{.State.Health.Status}}' coolify 2>/dev/null || echo missing)"
    printf '"coolify_proxy":"%s"' "$(docker inspect -f '{{.State.Status}}' coolify-proxy 2>/dev/null || echo missing)"
    printf '},'
    printf '"gvisor":"%s",' "$(runsc --version 2>/dev/null | head -1 | awk '{print $3}')"
    printf '"agent_sandboxes_running":%s,' "$(docker ps -q --filter name=oi-sb- | wc -l)"
    printf '"snapshots":['
    first=1
    local conf
    for conf in "$FACTORY_DIR"/projects/*/project.sh; do
      local pre; pre="$(sed -n 's/^PREFIX=\([a-z0-9]*\).*/\1/p' "$conf")"
      [ -n "$pre" ] || continue
      local c; c="$(pg "select shobj_description(oid, 'pg_database') from pg_database where datname = '${pre}_snapshot'" 2>/dev/null | sed 's/["\\]/ /g')"
      [ $first = 1 ] || printf ','; first=0
      printf '{"project":"%s","note":"%s"}' "$(basename "$(dirname "$conf")")" "$c"
    done
    printf ']}\n'
  } > "$tmp"
  python3 -m json.tool "$tmp" >/dev/null && install -m 644 "$tmp" "$out"
  rm -f "$tmp"
}

agent_say() {  # task id; message on stdin
  local id="$1" body
  [[ "$id" =~ ^[0-9]{6}-[0-9a-f]{6}$ ]] || die "not a task id: $id"
  body="$(python3 -c 'import json,sys; print(json.dumps({"from": "factory", "text": sys.stdin.read()}))')"
  curl -fsS -m 15 -X POST -H "Authorization: Bearer $(cat /opt/factory/agents-runner-token)" \
    -H "Content-Type: application/json" --data "$body" "http://127.0.0.1:19300/tasks/$id/messages" >/dev/null
  log "reported to agent task $id"
}

case "$cmd" in
  agent-say)    [ $# -eq 1 ] || die "usage: agent-say <task-id> < message"; agent_say "$1" ;;
  status)       status ;;
  snapshot-all)
    for conf in "$FACTORY_DIR"/projects/*/project.sh; do
      p="$(basename "$(dirname "$conf")")"
      grep -q '^SOURCE_DB_CONTAINER=' "$conf" || continue
      ( snapshot "$p" ) || echo "snapshot $p failed" >&2
    done ;;
  sync)        sync ;;
  runner-add)  [ $# -ge 2 ] || die "usage: runner-add <owner/repo> <registration token> [index]"; runner_add "$@" ;;
  self-update) self_update ;;
  e2e)      [ $# -ge 3 ] || die "usage: e2e <project> <N> <checkout> [sha]"; e2e "$@" ;;
  snapshot) [ $# -eq 1 ] || die "usage: snapshot <project>"; snapshot "$1" ;;
  up)       [ $# -ge 3 ] || die "usage: up <project> <N> <checkout> [branch]"; up "$@" ;;
  down)     [ $# -eq 2 ] || die "usage: down <project> <N>"; down "$@" ;;
  reset)    [ $# -eq 2 ] || die "usage: reset <project> <N>"; load_project "$1"
            docker compose -p "$PREFIX-pr-$2" stop -t 10 >&2; copy_data "$2"
            docker compose -p "$PREFIX-pr-$2" start >&2 ;;
  ls)       docker ps --filter name=-pr- --format '{{.Names}}\t{{.Status}}' | sort; ls /srv/factory/state 2>/dev/null ;;
  *)        sed -n '2,12p' "$0" | sed 's/^# \{0,1\}//'; [ -z "$cmd" ] || exit 2 ;;
esac
