#!/usr/bin/env bash
# factory - look at and talk to a running environment as a signed-in user.
#
#   factory url   <target>                       base URL of the app
#   factory login <target>                       one single-use sign-in URL
#   factory api   <target> <METHOD> <path> [json] call the API signed in
#   factory shot  <target> <path> [options]      screenshot a page signed in
#
#   factory init  <project> --domain D --prefix P --repo owner/repo [--repo-dir DIR]
#                 scaffold projects/<project>/ and (with --repo-dir) the repo's workflow
#   factory runner <project> [count]             more self-hosted runners on the VPS for its repo
#   factory push                                 push this factory repo (the box pulls it in <=5 min)
#
# Hand work to the factory's agents (the box's agents API, over ssh vps);
# the project is -p, else the one whose repo is this checkout's origin:
#   factory task [--auto] <text>                 a change (brief first; --auto skips it)
#   factory report <text>                        a bug report: triage, reproduce, file the issue
#   factory program <goal>                       a coordinator plans phases of changes
#   factory batch < items.txt                    one task per line, no briefs
#   factory tasks [--all]                        open tasks (--all: every task)
#   factory show <id> [n]                        status, PR, the last n messages (8)
#   factory reply <id> <text>                    answer the agent ("go", a decision, a steer)
#   factory wait <id> [seconds]                  block until it says something new or needs you
#   factory stop|pause <id>                      stop it, or leave a checkpoint to resume
#   factory digest [hours]                       the morning summary, now
#
# <target> is `staging` or a PR number (`458`, `pr458`). Project: -p <name>
# or FACTORY_PROJECT (required for environment commands). API paths are relative to the
# project's API root (`/me`, `/threads`), page paths to the app root (`/`,
# `/reports`). Sessions are cached in ~/.cache/factory; nothing is printed
# that carries a token except `login`'s own output.
set -euo pipefail
FACTORY_DIR="$(cd "$(dirname "$(readlink -f "$0" 2>/dev/null || echo "$0")")/.." && pwd)"
project="${FACTORY_PROJECT:-}"
if [ "${1:-}" = "-p" ]; then project="$2"; shift 2; fi
explicit_project="$project"

# commands that are not about a running environment
case "${1:-}" in
  init)
    shift; name="${1:?usage: factory init <project> --domain D --prefix P --repo owner/repo [--repo-dir DIR]}"; shift
    domain=""; prefix=""; repo=""; repo_dir=""
    while [ $# -gt 0 ]; do case "$1" in
      --domain) domain="$2"; shift 2 ;; --prefix) prefix="$2"; shift 2 ;;
      --repo) repo="$2"; shift 2 ;; --repo-dir) repo_dir="$2"; shift 2 ;;
      *) echo "unknown option $1" >&2; exit 2 ;; esac; done
    [ -n "$domain" ] && [ -n "$prefix" ] && [ -n "$repo" ] || { echo "--domain, --prefix and --repo are required" >&2; exit 2; }
    [[ "$prefix" =~ ^[a-z][a-z0-9]{1,9}$ ]] || { echo "prefix: 2-10 lowercase letters/digits" >&2; exit 2; }
    for p in "$FACTORY_DIR"/projects/*/project.sh; do
      grep -q "^PREFIX=$prefix\b" "$p" && { echo "prefix $prefix is taken by $p" >&2; exit 1; }
    done
    dest="$FACTORY_DIR/projects/$name"; [ -e "$dest" ] && { echo "$dest exists" >&2; exit 1; }
    mkdir -p "$dest"
    for f in project.sh preview.compose.yaml; do
      sed -e "s#__PROJECT__#$name#g; s#__DOMAIN__#$domain#g; s#__PREFIX__#$prefix#g; s#__REPO__#$repo#g" \
        "$FACTORY_DIR/templates/project/$f" > "$dest/$f"
    done
    if [ -n "$repo_dir" ]; then
      mkdir -p "$repo_dir/.github/workflows"
      sed -e "s#__PROJECT__#$name#g; s#__PREFIX__#$prefix#g" "$FACTORY_DIR/templates/preview.yml" \
        > "$repo_dir/.github/workflows/preview.yml"
      echo "wrote $repo_dir/.github/workflows/preview.yml"
    fi
    cat <<NEXT
scaffolded $dest. Next:
  1. fill in $dest/project.sh (build_images, run_e2e, data source) and preview.compose.yaml
  2. Cloudflare: a proxied "*" record for $domain; origin cert at /etc/ssl/cloudflare/$domain.pem/.key on the box
  3. factory push          (the box syncs routes for $domain within 5 minutes)
  4. factory runner $name  (a runner for $repo)
  5. commit .github/workflows/preview.yml in $repo and open a PR: it previews itself
NEXT
    exit 0 ;;
  runner)
    name="${2:?usage: factory runner <project> [count]}"; count="${3:-1}"
    # shellcheck source=/dev/null
    . "$FACTORY_DIR/projects/$name/project.sh"
    [ -n "${REPO:-}" ] || { echo "projects/$name has no REPO" >&2; exit 1; }
    have="$(gh api "repos/$REPO/actions/runners" --jq '[.runners[] | select(.labels[].name == "factory")] | length')"
    for i in $(seq $((have + 1)) $((have + count))); do
      token="$(gh api -X POST "repos/$REPO/actions/runners/registration-token" --jq .token)"
      ssh vps "factory-box runner-add $REPO $token $i"
    done
    exit 0 ;;
  push)
    git -C "$FACTORY_DIR" push -q && echo "pushed; the box pulls within 5 minutes (or: ssh vps factory-box self-update)"
    exit 0 ;;
  task|report|program|batch|tasks|show|reply|stop|pause|wait|digest)
    cmd="$1"; shift
    # the agents API listens on the box's loopback; its token is read there and never leaves the box
    agents() { # METHOD PATH [JSON]
      local out code
      out="$(printf '%s' "${3:-}" | ssh vps "curl -s -w '\n%{http_code}' -X $1 -H \"authorization: Bearer \$(cat /opt/factory/agents/api-token)\" -H content-type:application/json --data-binary @- 'http://127.0.0.1:19300$2'")"
      code="${out##*$'\n'}"; out="${out%$'\n'*}"
      [[ "$code" == 2* ]] || { echo "agents API $1 $2: HTTP $code $out" >&2; exit 1; }
      printf '%s\n' "$out"
    }
    # the project: -p, else the one whose repo is this checkout's origin
    target_project() {
      [ -n "$explicit_project" ] && { echo "$explicit_project"; return; }
      local repo
      repo="$(git remote get-url origin 2>/dev/null | sed -E 's#^(git@[^:]+:|https?://[^/]+/)##; s#\.git$##')"
      local p; p="$(ssh -n vps cat /opt/factory/agents/projects.json | jq -r --arg r "$repo" 'to_entries[] | select(.value.repo | ascii_downcase == ($r | ascii_downcase)) | .key' | head -1)"
      [ -n "$p" ] || { echo "no factory project for ${repo:-this directory}; pass -p <project> ($(ssh -n vps cat /opt/factory/agents/projects.json | jq -r 'keys | join(", ")'))" >&2; exit 2; }
      echo "$p"
    }
    text_arg() { if [ $# -gt 0 ]; then printf '%s' "$*"; else cat; fi; }
    task_id() { [[ "${1:-}" =~ ^[0-9]{6}-[0-9a-f]{6}$ ]] || { echo "usage: factory $cmd <task id> ..." >&2; exit 2; }; }
    created() { jq -r '"\(.id)  \(.project)  \(.kind)  \(.status)  \(.title)"'; }
    case "$cmd" in
      task)
        auto=false; [ "${1:-}" = --auto ] && { auto=true; shift; }
        p="$(target_project)"; text="$(text_arg "$@")"; [ -n "$text" ] || { echo "usage: factory task [--auto] <text>" >&2; exit 2; }
        agents POST /tasks "$(jq -n --arg p "$p" --arg t "$text" --argjson a "$auto" '{project: $p, text: $t, auto: $a}')" | created ;;
      report)
        p="$(target_project)"; text="$(text_arg "$@")"; [ -n "$text" ] || { echo "usage: factory report <text>" >&2; exit 2; }
        agents POST /tasks "$(jq -n --arg p "$p" --arg t "$text" '{project: $p, text: $t, kind: "report"}')" | created ;;
      program)
        p="$(target_project)"; text="$(text_arg "$@")"; [ -n "$text" ] || { echo "usage: factory program <goal>" >&2; exit 2; }
        agents POST /programs "$(jq -n --arg p "$p" --arg g "$text" '{project: $p, goal: $g}')" | created ;;
      batch)
        p="$(target_project)"
        agents POST /batches "$(jq -Rn --arg p "$p" '{project: $p, items: [inputs | select(length > 0)]}')" \
          | jq -r '"batch \(.batch)", (.tasks[] | "\(.id)  \(.status)  \(.title)")' ;;
      tasks)
        filter='select(.status != "done" and .status != "stopped" and .status != "merged")'; [ "${1:-}" = --all ] && filter='.'
        agents GET /tasks | jq -r "sort_by(.updatedAt) | .[] | $filter"' | "\(.id)  \(.project)  \(.kind)  \(.status)\(if .running then " (running)" else "" end)\(if .pr then "  PR #\(.pr.number)" else "" end)  \(.title | gsub("[\r\n]"; " "))"' ;;
      show)
        task_id "${1:-}"; n="${2:-8}"
        agents GET "/tasks/$1" | jq -r --argjson n "$n" '
          "\(.id)  \(.project)  \(.kind)  \(.status)\(if .running then " (running)" else "" end)",
          "title: \(.title | gsub("[\r\n]"; " "))",
          (if .pr then "PR: \(.pr.url) (\(.pr.state))" else empty end),
          (if .verdict then "review: \(.verdict) after \(.reviews) round(s)" else empty end),
          "cost: $\(.costUsd // 0 | . * 100 | round / 100)",
          (if (.activity | length) > 0 then "last tool: \(.activity[-1].tool) \(.activity[-1].detail | .[0:160])" else empty end),
          "", (.messages[-$n:][] | "--- \(.from) \(.at)\n\(.text)\n")' ;;
      reply)
        task_id "${1:-}"; id="$1"; shift; text="$(text_arg "$@")"; [ -n "$text" ] || { echo "usage: factory reply <id> <text>" >&2; exit 2; }
        agents POST "/tasks/$id/messages" "$(jq -n --arg t "$text" '{text: $t}')" >/dev/null && echo "sent to $id" ;;
      stop|pause)
        task_id "${1:-}"; agents POST "/tasks/$1/$cmd" | jq -r '"\(.id)  \(.status)"' ;;
      digest)
        agents GET "/digest?hours=${1:-24}" | jq . ;;
      wait)
        # until the task says something new or needs the person; prints what was said
        task_id "${1:-}"; id="$1"; every="${2:-30}"
        t="$(agents GET "/tasks/$id")"; seen="$(jq '.messages | length' <<<"$t")"; was="$(jq -r .status <<<"$t")"
        while :; do
          sleep "$every"
          t="$(agents GET "/tasks/$id")" || continue
          if [ "$(jq '.messages | length' <<<"$t")" -gt "$seen" ] \
            || jq -e --arg was "$was" '.status != $was and (.status | test("^(decision needed|waiting for you|ready for you|done|merged|stopped|paused)$"))' <<<"$t" >/dev/null; then
            jq -r --argjson s "$seen" '"\(.id)  \(.status)\(if .pr then "  PR \(.pr.url)" else "" end)", "", (.messages[$s:][] | "--- \(.from) \(.at)\n\(.text)\n")' <<<"$t"
            exit 0
          fi
        done ;;
    esac
    exit 0 ;;
esac

[ -n "$project" ] || { echo "which project? -p <name> or FACTORY_PROJECT" >&2; exit 2; }
conf="$FACTORY_DIR/projects/$project/project.sh"
[ -f "$conf" ] || { echo "unknown project: $project (no $conf)" >&2; exit 2; }
# shellcheck source=/dev/null
. "$conf"

cache="$HOME/.cache/factory/$project"; mkdir -p "$cache"; chmod 700 "$cache"

die() { echo "factory: $*" >&2; exit 1; }

parse_target() {
  case "${1:-}" in
    staging) kind=staging; host="$STAGING_HOST" ;;
    pr[0-9]*|[0-9]*) kind=preview; pr="${1#pr}"
      if [ "${SANDBOXES:-}" = coolify ]; then host="pr$pr.$DOMAIN"; else host="p-pr$pr.$DOMAIN"; fi ;;
    *) die "target must be 'staging' or a PR number, got '${1:-}'" ;;
  esac
  base="https://$host"
  jar="$cache/$1.jar"
}

# previews sit behind basic auth; the password lives on the box
basic_auth() {
  [ "$kind" = preview ] || return 0
  local f="$HOME/.config/factory/preview-password"
  if [ ! -s "$f" ]; then
    mkdir -p "$(dirname "$f")"; (umask 077; ssh vps cat /opt/factory/preview-password > "$f")
  fi
  printf 'factory:%s' "$(cat "$f")"
}

# the container's logger shares stdout with the URL: keep only the URL line
mint() {
  { if [ "$kind" = staging ]; then mint_staging; else mint_preview "$pr"; fi; } |
    grep -E '^https://' | tail -1 | grep . || return 1
}

# redeem a fresh sign-in link into a session cookie jar
new_session() {
  local url token auth
  url="$(mint)" || die "could not mint a sign-in link for $target"
  token="${url#*#t=}"; token="${token%%&*}"
  auth="$(basic_auth)"
  (umask 077; curl -fsS ${auth:+-u "$auth"} -c "$jar" -H 'Content-Type: application/json' \
     -d "{\"t\":\"$token\"}" "$base$REDEEM_PATH" >/dev/null) ||
    die "redeeming the sign-in link failed"
}

call_api() {  # METHOD PATH [BODY] -> prints body, returns http code in $code
  local auth out; auth="$(basic_auth)"; out="$cache/.last"
  code=$(curl -sS ${auth:+-u "$auth"} -b "$jar" -c "$jar" -o "$out" -w '%{http_code}' \
    -X "$1" ${3:+-H 'Content-Type: application/json' --data "$3"} "$base$API_PATH$2")
}

cmd="${1:-}"; shift || true
target="${1:-}"; shift || true
case "$cmd" in
  url)   parse_target "$target"; echo "$base$APP_PATH" ;;
  login) parse_target "$target"; mint ;;
  api)
    parse_target "$target"
    [ $# -ge 2 ] || die "usage: factory api <target> <METHOD> <path> [json]"
    [ -s "$jar" ] || new_session
    call_api "$1" "$2" "${3:-}"
    if [ "$code" = 401 ]; then new_session; call_api "$1" "$2" "${3:-}"; fi
    cat "$cache/.last"; echo
    echo "HTTP $code" >&2
    [ "${code:0:1}" = 2 ] ;;
  shot)
    parse_target "$target"
    [ $# -ge 1 ] || die "usage: factory shot <target> <path> [--width N] [--full] [--out file]"
    [ -s "$jar" ] || new_session
    # a dead session shows the sign-in page: check before shooting
    call_api GET /me; [ "$code" = 401 ] && new_session
    auth="$(basic_auth)"
    [ -d "$FACTORY_DIR/tools/node_modules/playwright-core" ] ||
      (cd "$FACTORY_DIR/tools" && npm install --silent >/dev/null)
    FACTORY_JAR="$jar" FACTORY_BASIC="$auth" \
      node "$FACTORY_DIR/tools/shot.mjs" "$base$APP_PATH" "$@" ;;
  *) sed -n '2,15p' "$0" | sed 's/^# \{0,1\}//'; [ -z "$cmd" ] || exit 2 ;;
esac
