# /etc/cron.d/factory - the box clock is Tashkent time
# 03:00: fresh disarmed snapshot of every project's source data
0 3 * * * factory /usr/local/bin/factory-box snapshot-all >> /srv/factory/state/snapshot.log 2>&1
# every 5 minutes: pull the factory repo; regenerate routes if it changed
*/5 * * * * root /usr/local/bin/factory-box self-update >> /srv/factory/state/self-update.log 2>&1
# every minute: facts for the dashboard (it has no docker access of its own)
* * * * * root /usr/local/bin/factory-box status 2>> /srv/factory/state/status.err
