{
  "factory": {
    "about": "The factory itself: agents, Slack and Telegram bots, dashboard, box scripts, brain.",
    "repo": "omardmv/factory",
    "base": "main",
    "autoMerge": "main",
    "mergeMethod": "squash",
    "githubApp": { "id": "<app id>", "key": "github-app-factory.pem", "bot": { "name": "<app slug>[bot]", "email": "<user id>+<app slug>[bot]@users.noreply.github.com" } }
  },
  "shop": {
    "about": "One line on what this project is, so the factory can tell from a message which project it is about.",
    "repo": "<owner>/<repo>",
    "base": "staging",
    "autoMerge": "staging",
    "requiredChecks": ["e2e"],
    "loops": { "security": "weekly", "docs": "weekly" },
    "baseBuild": { "branch": "staging", "checkout": "/srv/factory/shop-base-src" },
    "readDb": { "host": "db.internal", "port": 5432, "name": "shop", "user": "agent_ro", "passwordFile": "shop-readdb-password", "sslmode": "require" },
    "mergeMethod": "squash",
    "githubApp": { "id": "<app id>", "key": "github-app-factory.pem", "bot": { "name": "<app slug>[bot]", "email": "<user id>+<app slug>[bot]@users.noreply.github.com" } }
  }
}
